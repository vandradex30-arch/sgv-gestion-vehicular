# Copiar a .env (nunca subir .env al repositorio)
POSTGRES_PASSWORD=cambiar_owner
SGV_APP_PASSWORD=cambiar_app
SGV_WORKER_PASSWORD=cambiar_worker

# Conexión del dueño de las tablas: SOLO para migraciones y pruebas de BD
DATABASE_URL_OWNER=postgres://sgv_owner:cambiar_owner@localhost:5432/sgv
# Conexión de la aplicación: rol sin BYPASSRLS
DATABASE_URL_APP=postgres://sgv_app:cambiar_app@localhost:5432/sgv

# Firma de los tokens de acceso: mínimo 32 caracteres aleatorios (ej.: openssl rand -hex 32)
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio_de_32_o_mas_caracteres

# Recuperación de dispositivos revocados (opcional). Se generan con: pnpm --filter @sgv/api create-recovery-keys
# RECOVERY_PUBLIC_KEY=
# RECOVERY_PRIVATE_KEY=

NODE_ENV=development
PORT=3000
DB_POOL_MAX=10
# Solo desarrollo y pruebas. La API se niega a arrancar si esto es true en producción.
ALLOW_DEV_ACTOR=false
